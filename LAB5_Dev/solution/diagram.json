{
  "version": 1,
  "author": "Antigravity IoT Lab",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht11", "id": "dht", "top": -120, "left": -80, "attrs": { "temperature": "28.5", "humidity": "65" } },
    { "type": "wokwi-potentiometer", "id": "pot", "top": -120, "left": 60, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay", "top": 120, "left": -80, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": 120, "left": 60, "attrs": { "i2cAddress": "0x3c" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "dht:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "dht:VCC", "red", [ "v0" ] ],
    [ "esp:33", "dht:SDA", "green", [ "v0" ] ],
    [ "esp:GND.2", "pot:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot:VCC", "red", [ "v0" ] ],
    [ "esp:36", "pot:SIG", "orange", [ "v0" ] ],
    [ "esp:GND.3", "relay:GND", "black", [ "v0" ] ],
    [ "esp:5V", "relay:VCC", "red", [ "v0" ] ],
    [ "esp:5", "relay:IN", "purple", [ "v0" ] ],
    [ "esp:GND.4", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "blue", [ "v0" ] ]
  ],
  "dependencies": {}
}
