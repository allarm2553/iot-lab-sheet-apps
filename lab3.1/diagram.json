{
  "version": 1,
  "author": "IoT Lab Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -80, "left": 60, "attrs": { "color": "blue", "label": "STATUS LED (GPIO 2)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -40, "left": 60, "attrs": { "value": "330" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:2", "led1:A", "blue", [ "v0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
