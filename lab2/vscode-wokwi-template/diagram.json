{
  "version": 1,
  "author": "IoT Lab Learning System",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-ssd1306",
      "id": "oled",
      "top": -160,
      "left": -60,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -150,
      "left": 160,
      "attrs": { "temperature": "28.5", "humidity": "62" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot",
      "top": 120,
      "left": -150,
      "attrs": { "value": "50" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": -40,
      "left": -140,
      "attrs": { "color": "green", "label": "SW1 (GPIO 0)" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": -20,
      "left": 170,
      "attrs": { "label": "Relay 1 (Fan)" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay2",
      "top": 120,
      "left": 170,
      "attrs": { "label": "Relay 2 (Mist)" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 50,
      "left": -100,
      "attrs": { "color": "red", "label": "LED (GPIO 18)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 90,
      "left": -100,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "oled:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled:SCL", "esp:22", "yellow", [ "v0" ] ],
    [ "oled:SDA", "esp:21", "green", [ "v0" ] ],
    [ "dht:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "dht:SDA", "esp:33", "gold", [ "v0" ] ],
    [ "pot:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot:SIG", "esp:36", "cyan", [ "v0" ] ],
    [ "btn1:1.l", "esp:GND.1", "black", [ "v0" ] ],
    [ "btn1:2.l", "esp:0", "green", [ "v0" ] ],
    [ "relay1:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "relay1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "relay1:IN", "esp:5", "blue", [ "v0" ] ],
    [ "relay2:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "relay2:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "relay2:IN", "esp:23", "purple", [ "v0" ] ],
    [ "esp:18", "led1:A", "red", [ "v0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
