{
  "version": 1,
  "author": "IoT Lab Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -160, "left": -20, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -150, "left": -170, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot", "top": -150, "left": 130, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 160, "left": -150, "attrs": { "color": "green", "label": "SW1 (GPIO 0)" } },
    { "type": "wokwi-relay-module", "id": "relay1", "top": 160, "left": 100, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 80, "left": -150, "attrs": { "color": "red", "label": "ALERT LED (GPIO 18)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 80, "left": -80, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "blue", [ "v0" ] ],

    [ "esp:GND.1", "dht:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "dht:VCC", "red", [ "v0" ] ],
    [ "esp:33", "dht:SDA", "green", [ "v0" ] ],

    [ "esp:GND.1", "pot:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot:VCC", "red", [ "v0" ] ],
    [ "esp:VP", "pot:SIG", "orange", [ "v0" ] ],

    [ "esp:GND.2", "btn1:1.l", "black", [ "v0" ] ],
    [ "esp:0", "btn1:2.l", "green", [ "v0" ] ],

    [ "esp:GND.2", "relay1:GND", "black", [ "v0" ] ],
    [ "esp:5V", "relay1:VCC", "red", [ "v0" ] ],
    [ "esp:5", "relay1:IN", "purple", [ "v0" ] ],

    [ "esp:18", "led1:A", "orange", [ "v0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
