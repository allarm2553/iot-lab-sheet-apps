{
  "version": 1,
  "author": "Antigravity IoT Lab",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -90,
      "left": 130,
      "attrs": { "color": "red", "label": "LED1 (GPIO23)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -30,
      "left": 130,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led2",
      "top": -90,
      "left": 210,
      "attrs": { "color": "blue", "label": "LED2 (GPIO19)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": -30,
      "left": 210,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 150,
      "left": 200,
      "attrs": { "color": "green", "label": "SW1 (GPIO18)" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "led1:C", "black", [ "v0" ] ],
    [ "esp:23", "r1:1", "red", [ "v0" ] ],
    [ "r1:2", "led1:A", "red", [ "v0" ] ],
    [ "esp:GND.2", "led2:C", "black", [ "v0" ] ],
    [ "esp:19", "r2:1", "blue", [ "v0" ] ],
    [ "r2:2", "led2:A", "blue", [ "v0" ] ],
    [ "esp:18", "btn1:1.l", "green", [ "v0" ] ],
    [ "esp:GND.2", "btn1:2.l", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
