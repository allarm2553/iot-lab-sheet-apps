{
  "version": 1,
  "author": "IoT Lab Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": -120, "left": -90, "attrs": { "color": "green", "label": "SW1 (GPIO 0)" } },
    { "type": "wokwi-relay-module", "id": "relay1", "top": 160, "left": -130, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay2", "top": 160, "left": 120, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -30, "left": 160, "attrs": { "color": "red", "label": "ALERT LED (GPIO 18)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 40, "left": 160, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:GND.1", "btn1:1.l", "black", [ "v0" ] ],
    [ "esp:0", "btn1:2.l", "green", [ "v0" ] ],

    [ "esp:GND.2", "relay1:GND", "black", [ "v0" ] ],
    [ "esp:5V", "relay1:VCC", "red", [ "v0" ] ],
    [ "esp:5", "relay1:IN", "blue", [ "v0" ] ],

    [ "esp:GND.2", "relay2:GND", "black", [ "v0" ] ],
    [ "esp:5V", "relay2:VCC", "red", [ "v0" ] ],
    [ "esp:23", "relay2:IN", "purple", [ "v0" ] ],

    [ "esp:18", "led1:A", "orange", [ "v0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
