{
  "version": 1,
  "author": "IoT Lab Learning System",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": -90,
      "left": -120,
      "attrs": { "color": "green", "label": "SW1 (GPIO 0)" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": -80,
      "left": 160,
      "attrs": { "label": "Relay 1 (Fan)" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay2",
      "top": 120,
      "left": 160,
      "attrs": { "label": "Relay 2 (Mist)" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 60,
      "left": -100,
      "attrs": { "color": "red", "label": "LED (GPIO 18)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 100,
      "left": -100,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "btn1:1.l", "esp:GND.1", "black", [ "v0" ] ],
    [ "btn1:2.l", "esp:0", "green", [ "v0" ] ],
    [ "relay1:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "relay1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "relay1:IN", "esp:5", "blue", [ "v0" ] ],
    [ "relay2:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "relay2:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "relay2:IN", "esp:23", "purple", [ "v0" ] ],
    [ "esp:18", "led1:A", "red", [ "v0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
